{
	"name": "music-ocr",
	"version": "0.3.0",
	"description": "Fully client-side Optical Music Recognition web app (JavaScript port of copisteria, copista ONNX models, Verovio rendering)",
	"type": "module",
	"license": "MIT AND Apache-2.0",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"fetch:models": "uv run scripts/models/export_copista.py",
		"fetch:docaligner": "uv run scripts/models/fetch_docaligner.py",
		"fetch:soundfont": "node scripts/soundfont/fetch.mjs",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"e2e": "node scripts/e2e-test.mjs --score test_images/reference/manifest.json test_images/Rondo-MuzioClementi-0.png test_images/Rondo-MuzioClementi-1.png test_images/Rondo-MuzioClementi-2.png",
		"eval": "node scripts/eval/score.mjs test_images/reference/manifest.json",
		"upload:models": "uv run scripts/models/upload_hf.py"
	},
	"dependencies": {
		"jspdf": "^4.2.1",
		"onnxruntime-web": "^1.22.0",
		"svg2pdf.js": "^2.9.0",
		"verovio": "^6.2.0",
		"vue": "^3.5.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.0.0",
		"@vitejs/plugin-vue": "^5.2.4",
		"onnxruntime-node": "^1.31.1",
		"pngjs": "^7.0.0",
		"vite": "^5.4.21",
		"vitest": "^3.2.0"
	}
}
